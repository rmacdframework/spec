# Example .env. Copy to `.env` and fill in your own values.
# `.env` is gitignored; this template is safe to commit.

# Anthropic API key used by the runnable examples.
# Get one from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the demo model.
# Defaults to claude-haiku-4-5 for cheap/fast runs.
# RMACD_DEMO_MODEL=claude-sonnet-4-6
