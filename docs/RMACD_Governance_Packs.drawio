        <mxCell id="r5" value="Decision&#10;&#10;allow / approve / deny" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;fontSize=11;verticalAlign=top;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="1240" y="510" width="230" height="100" as="geometry" />
