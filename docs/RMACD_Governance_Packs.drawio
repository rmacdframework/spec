        <!-- Title -->
        <mxCell id="title" value="How RMACD Governance Packs Work" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1620" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Author once (AI-assisted, human-approved, signed) — then enforce deterministically. SDK 0.11.0 · rmacd.packs" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=2;fontColor=#666666" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="1620" height="20" as="geometry" />
        </mxCell>

        <!-- ===================== AUTHORING BAND ===================== -->
