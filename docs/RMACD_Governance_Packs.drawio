        <mxCell id="builtins" value="19 built-in packs&#10;&#10;shell · aws · gcloud · az · kubectl · github · gitlab&#10;sql · filesystem · jira · confluence · slack&#10;google-drive · postgres · boto3 · aws-api-mcp&#10;azure-mcp · gcp-toolbox · ms365" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontSize=10;dashed=1;verticalAlign=top;spacingTop=8" vertex="1" parent="1">
