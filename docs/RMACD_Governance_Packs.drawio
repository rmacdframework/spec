        <!-- enforcer → audit -->
        <mxCell id="audit" value="Audit record&#10;&#10;one AuditRecord per decision (Appendix C.6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F0E0;strokeColor=#3F9E3F;fontSize=11;verticalAlign=top;spacingTop=8" vertex="1" parent="1">
