        <!-- ===================== RUNTIME BAND ===================== -->
        <mxCell id="rt_banner" value="RUNTIME — deterministic (no LLM)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#3070b0" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="1000" height="22" as="geometry" />
