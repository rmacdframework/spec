        <!-- pack + built-ins feed the registry -->
        <mxCell id="e_pack_r2" style="endArrow=classic;html=1;strokeWidth=2;exitX=0.25;exitY=1;entryX=0.3;entryY=0;dashed=1" edge="1" parent="1" source="pack" target="r2">
          <mxGeometry relative="1" as="geometry" />
