<mxfile host="app.diagrams.net" agent="rmacd-framework" version="29.3.0">
  <diagram id="rmacd-governance-packs" name="RMACD Governance Packs">
    <mxGraphModel dx="1665" dy="890" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
