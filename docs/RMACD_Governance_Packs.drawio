        </mxCell>

        <!-- ===================== NOTE ===================== -->
        <mxCell id="note" value="Determinism &amp; trust: the LLM assists only at authoring time — runtime classification is pure data, so the same call always yields the same decision. The §12.5 immutable floor, the agent profile, and the per-tool capability ceiling always gate. In production, load_packs(require_signed=True, trusted_keys=…) refuses any unsigned or untrusted pack." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;fontSize=11;fontStyle=2;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8" vertex="1" parent="1">
