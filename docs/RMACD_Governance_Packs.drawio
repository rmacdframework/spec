        <!-- ===================== ARTIFACT ===================== -->
        <mxCell id="pack" value="Governance Pack — signed data&#10;&#10;YAML / JSON · content_hash + Ed25519 signature&#10;rules: when (tool / args) → operation · data tier · target&#10;verb_table · pattern_map · resolver · capability ceiling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F1;strokeColor=#3070b0;strokeWidth=2;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=8" vertex="1" parent="1">
