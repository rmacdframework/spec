        <mxCell id="r1" value="Agent tool call&#10;&#10;(tool_name, args)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontSize=11;dashed=1;verticalAlign=top;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="load_packs([...]) → ToolsRegistry&#10;&#10;DeclarativeClassifier per tool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F1;strokeColor=#3070b0;fontSize=11;verticalAlign=top;spacingTop=8" vertex="1" parent="1">
