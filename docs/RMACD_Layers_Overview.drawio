<mxfile host="app.diagrams.net" type="device">
  <diagram id="rmacd-layers-overview" name="RMACD Five Layers">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="RMACD — Five Layers of Enterprise AI-Agent Governance" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=21;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="60" y="22" width="980" height="32" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Control what AI agents may do, on which data, and with how much independence — a standard, an engine that enforces it, and a library that makes adoption fast." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=2;fontColor=#666666" vertex="1" parent="1">
          <mxGeometry x="90" y="58" width="920" height="40" as="geometry" />
        </mxCell>

        <!-- Layer 1 -->
        <mxCell id="n1" value="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=32;fontStyle=1;fontColor=#6C8EBF" vertex="1" parent="1">
          <mxGeometry x="60" y="116" width="64" height="96" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="THE GOVERNANCE STANDARD&#10;The rulebook for what AI agents may do — our market position, and the shared language for security, compliance &amp; engineering teams." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontColor=#1A2B4A;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10" vertex="1" parent="1">
          <mxGeometry x="132" y="116" width="908" height="96" as="geometry" />
        </mxCell>

        <!-- Layer 2 -->
        <mxCell id="n2" value="2" style="text;html=1;align=center;verticalAlign=middle;fontSize=32;fontStyle=1;fontColor=#82B366" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="64" height="96" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="REAL-TIME ENFORCEMENT&#10;Every action an agent attempts is allowed, blocked, or escalated to a human — with one safety guarantee that cannot be switched off. Risk, contained." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontColor=#1E3A1E;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10" vertex="1" parent="1">
          <mxGeometry x="132" y="230" width="908" height="96" as="geometry" />
        </mxCell>

        <!-- Layer 3 -->
        <mxCell id="n3" value="3" style="text;html=1;align=center;verticalAlign=middle;fontSize=32;fontStyle=1;fontColor=#C99A2E" vertex="1" parent="1">
          <mxGeometry x="60" y="344" width="64" height="96" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="READY-MADE POLICY LIBRARY&#10;22 governance packs for the cloud, identity &amp; business tools enterprises already run. Onboarding becomes configuration, not custom code. Speed to adoption." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontColor=#4A3B0A;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10" vertex="1" parent="1">
          <mxGeometry x="132" y="344" width="908" height="96" as="geometry" />
        </mxCell>

        <!-- Layer 4 -->
        <mxCell id="n4" value="4" style="text;html=1;align=center;verticalAlign=middle;fontSize=32;fontStyle=1;fontColor=#9673A6" vertex="1" parent="1">
          <mxGeometry x="60" y="458" width="64" height="96" as="geometry" />
        </mxCell>
        <mxCell id="l4" value="ACCOUNTABILITY &amp; DATA PROTECTION&#10;Human approvals, a tamper-evident record of every decision, and data-loss controls — the evidence that passes security, audit &amp; regulatory review." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontColor=#3A2A40;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10" vertex="1" parent="1">
          <mxGeometry x="132" y="458" width="908" height="96" as="geometry" />
        </mxCell>

        <!-- Layer 5 -->
        <mxCell id="n5" value="5" style="text;html=1;align=center;verticalAlign=middle;fontSize=32;fontStyle=1;fontColor=#D79B00" vertex="1" parent="1">
          <mxGeometry x="60" y="572" width="64" height="96" as="geometry" />
        </mxCell>
        <mxCell id="l5" value="PROVEN REFERENCE AGENTS&#10;Working agents running end-to-end on real AI platforms — demonstrable today, not a roadmap promise. The whole stack, de-risked." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontColor=#4A2E0A;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10" vertex="1" parent="1">
          <mxGeometry x="132" y="572" width="908" height="96" as="geometry" />
        </mxCell>

        <!-- Status banner -->
        <mxCell id="status" value="Status: all five layers built, published, and independently verified — SDK live on PyPI (rmacd-framework 0.12.0) · spec v1.4 · 22 governance packs." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;fontStyle=2;fontColor=#555555;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="60" y="698" width="980" height="52" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
