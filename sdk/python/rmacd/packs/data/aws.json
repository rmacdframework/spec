{
  "pack": "aws",
  "version": "1.0.0",
  "description": "RMACD classification for the AWS CLI (verb-noun actions matched by prefix; s3 high-level verbs handled directly).",
  "default_operation": "C",
  "provenance": {"authored_by": "rmacd", "llm_assisted": true, "review_status": "ai-drafted"},
  "rules": [
    {
      "id": "aws-cli",
      "when": {"tool": "aws"},
      "parse": {"arg": "command", "strip_wrappers": ["sudo", "env"], "verb_prefix_delimiters": ["-"]},
      "verb_table": {
        "describe": "R", "get": "R", "list": "R", "ls": "R", "head": "R",
        "lookup": "R", "search": "R", "view": "R", "show": "R", "scan": "R",
        "query": "R", "select": "R", "estimate": "R", "wait": "R", "help": "R",
        "mv": "M",
        "cp": "A", "sync": "C", "create": "A", "run": "A", "register": "A",
        "add": "A", "allocate": "A", "request": "A", "import": "A", "upload": "A",
        "provision": "A", "put": "C", "copy": "A", "publish": "A",
        "update": "C", "modify": "C", "set": "C", "attach": "C", "detach": "C",
        "associate": "C", "disassociate": "C", "enable": "C", "disable": "C",
        "start": "C", "stop": "C", "reboot": "C", "tag": "C", "untag": "C",
        "configure": "C", "restore": "C", "reset": "C",
        "delete": "D", "terminate": "D", "remove": "D", "deregister": "D",
        "release": "D", "revoke": "D", "cancel": "D", "purge": "D", "rm": "D",
        "destroy": "D"
      },
      "default": "C",
      "tier": {
        "pattern_map": [
          {"arg_regex": {"arg": "command", "pattern": "(iam|kms|secretsmanager|secret|ssm\\s+.*parameter|sts|cognito|password|credential)"}, "tier": "confidential"},
          {"arg_regex": {"arg": "command", "pattern": "(prod|prd|-pii|restricted)"}, "tier": "confidential"}
        ],
        "default": "internal"
      },
      "target": "aws://{command}",
      "capability": ["R", "M", "A", "C", "D"]
    }
  ]
}
