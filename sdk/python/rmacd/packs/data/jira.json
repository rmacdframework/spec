{
  "pack": "jira",
  "version": "1.0.0",
  "description": "RMACD classification for the Jira MCP server (Atlassian). Ships with confluence.",
  "default_operation": "C",
  "provenance": {"authored_by": "rmacd", "llm_assisted": true, "review_status": "ai-drafted"},
  "resolvers": [
    {"name": "jira_project_tier", "description": "Resolve a Jira project key to its data classification", "fail_closed_default": "confidential"}
  ],
  "rules": [
    {
      "id": "jira-read",
      "when": {"tool": ["jira_search", "jira_get_issue", "jira_get_project", "jira_list_projects", "jira_get_user", "jira_get_transitions"]},
      "classify": {"operation": "R", "tier": {"resolver": "jira_project_tier", "from": "project_key", "default": "internal"}, "target": "jira://{project_key}/{issue_key}"}
    },
    {
      "id": "jira-add",
      "when": {"tool": ["jira_create_issue", "jira_add_comment", "jira_add_attachment", "jira_create_issue_link"]},
      "classify": {"operation": "A", "tier": {"resolver": "jira_project_tier", "from": "project_key", "default": "internal"}, "target": "jira://{project_key}"}
    },
    {
      "id": "jira-move",
      "when": {"tool": "jira_move_issue"},
      "classify": {"operation": "M", "tier": {"resolver": "jira_project_tier", "from": "target_project_key", "default": "internal"}, "target": "jira://{issue_key}->{target_project_key}"}
    },
    {
      "id": "jira-change",
      "when": {"tool": ["jira_update_issue", "jira_transition_issue", "jira_assign_issue", "jira_edit_comment"]},
      "classify": {
        "operation": "C",
        "tier": {
          "pattern_map": [{"arg_regex": {"arg": "project_key", "pattern": "^(SEC|HR|LEGAL|FIN)$"}, "tier": "confidential"}],
          "resolver": "jira_project_tier", "from": "project_key", "default": "internal"
        },
        "target": "jira://{project_key}/{issue_key}"
      }
    },
    {
      "id": "jira-delete",
      "when": {"tool": ["jira_delete_issue", "jira_delete_comment"]},
      "classify": {"operation": "D", "tier": {"resolver": "jira_project_tier", "from": "project_key", "default": "confidential"}, "target": "jira://{project_key}/{issue_key}"}
    }
  ]
}
